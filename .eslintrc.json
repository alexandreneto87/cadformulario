{
  "env": {
    "browser": true,
    "es2021": true,
    "node": false,
    "jquery": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "semi": ["error", "always"],
    "indent": ["error", "tab"],
    "quotes": ["error", "single"],
    "no-var": "error",
    "prefer-const": "warn",
    "no-duplicate-imports": "error",
    "no-empty": "warn",
    "no-ex-assign": "error",
    "no-func-assign": "error",
    "no-obj-calls": "error",
    "no-redeclare": "error",
    "no-unreachable": "error",
    "valid-typeof": "error",
    "no-undef": "error",
    "no-unused-expressions": "warn",
    "no-useless-concat": "warn",
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "no-implicit-coercion": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-extend-native": "error",
    "no-extra-bind": "error",
    "no-invalid-this": "error",
    "no-multi-spaces": "error",
    "no-return-assign": "error",
    "no-shadow": "warn",
    "no-shadow-restricted-names": "error",
    "no-void": "error",
    "prefer-arrow-callback": "warn",
    "prefer-destructuring": "warn",
    "strict": ["error", "global"]
  },
  "globals": {
    "jQuery": "readonly",
    "window": "readonly",
    "document": "readonly",
    "console": "readonly",
    "alert": "readonly",
    "confirm": "readonly",
    "prompt": "readonly",
    "bootstrap": "readonly",
    "AppConfig": "readonly"
  },
  "ignorePatterns": [
    "node_modules/",
    "vendor/",
    "dist/",
    "build/",
    "*.min.js",
    "*.min.css"
  ]
}
