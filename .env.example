# ============================================
# VARIÁVEIS DE AMBIENTE (NÃO COMMITAR)
# Copiar para .env.local e preencher com credenciais reais
# ============================================

# Supabase Configuration (USAR CHAVES ANON NO FRONTEND!)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-do-dashboard

# Email Configuration (EmailJS - Para o webhook)
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key

# OR Email Configuration (Resend - Para o webhook)
VITE_RESEND_API_KEY=re_1234567890abcdefghijklmnopqrstuvwxyz

# App Configuration
VITE_APP_NAME="Sistema de Inscrição de Artistas"
VITE_APP_URL="https://seudominio.com"

# Debug
VITE_DEBUG=true

# ============================================
# IMPORTANTE:
# - VITE_SUPABASE_URL: URL do seu projeto
# - VITE_SUPABASE_ANON_KEY: CHAVE ANON (NÃO service key!)
# - Estas chaves são seguras para usar no frontend
# - Edge Function usará SUPABASE_SERVICE_KEY (segredo)
# - .gitignore já está configurado para ignorar .env
# ============================================
