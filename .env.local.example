# ============================================
# VARIÁVEIS DE AMBIENTE LOCAL (DEV)
# Copie este arquivo para .env.local e preencha com suas credenciais
# ============================================

# Supabase Configuration
VITE_SUPABASE_FUNCTION_URL=https://xxxxxxxxxxxxx.supabase.co/functions/v1

# Turnstile Anti-Spam (opcional, mas recomendado)
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAx0x00000000000
VITE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx0x00000000000xxxxxxxxxxxxx

# Email Configuration (EmailJS)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# OR Email Configuration (Resend)
VITE_RESEND_API_KEY=re_1234567890abcdefghijklmnopqrstuvwxyz

# App Configuration
VITE_APP_NAME="Sistema de Inscrição de Artistas"
VITE_APP_URL="http://localhost:3000"

# Debug
VITE_DEBUG=true
